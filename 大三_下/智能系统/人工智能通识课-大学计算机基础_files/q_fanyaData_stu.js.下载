//局部刷新页面
function reloadPage(jumpUrl) {
	var suffix = "&isAjax=isAjax";
	if(!jumpUrl) {
		var url = window.location.href;
        if(url.substring(url.length-1, url.length) === "#") {
            url = url.substring (0, url.length-1) + suffix;
        }else {
            url = url + suffix;
        }
    }else {
        url = jumpUrl+suffix;
    }

	var courseDataContent = $(".CourseDataContent");
    jQuery.ajax({
		type: "get",
		url: url,
		dataType: 'html',
		async: false,
		success: function (data) {
			data = data.replace(/(^\s*)|(\s*$)/g, "");
			courseDataContent.empty();
			courseDataContent.append(data);
			bulidPageNum();
            buildJiaoCanInfo();
            var isAccessibleCustomFid = $("#isAccessibleCustomFid").val();
            if (isAccessibleCustomFid && isAccessibleCustomFid == "1") {
                if (window.top && window.top.accessiblePlugs) {
                    // window.top.accessiblePlugs.taggeriframe();
                    window.top.accessiblePlugs.update();
                }
            }
		}});
}

