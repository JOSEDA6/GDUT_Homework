//保存到pop
function openCopyDiv(fldid, thisObj){
    if(thisObj) {
        var length = $(thisObj).find("ul .popMove_name").length;
        if(length>0) {
            return;
        }
    }

    var courseId = $("#courseid").val();
    $.ajax({
        type: "get",
        url : "/mooc2-ans/coursedata/cloud-disk-list",
        data: {
            "fldid": fldid,
            "courseId": courseId
        },
        success: function (data) {
            var json =  eval('(' + data.replace(/:\s*(\d{16,})(?=\s*[,\}])/g,":\"$1\"") + ')');
            if(!json.result) {
                $.toast({type: 'failure', content: I18N_Config.courseDataToast30});
                return;
            }
            if(fldid===0) {
                buildRootCloudDiskDiv(json);
            }else {
                buildCloudDiskDiv(json, thisObj);
            }
        },
        error: function (data) {
            $.toast({type: 'failure', content: I18N_Config.courseDataToast30});
        }
    });
}


function buildRootCloudDiskDiv(json) {
    var rootDiv = "<div class=\"popMove_name popMove_active\" id='" + json.curDir + "'><img src=\"/mooc2-ans/images/coursedata/file.png\"/><span class=\"popMove_text\">根目录</span></div>";
    var divObj = $(".popSaveShowHide .popMove_module .popMove_list .popMove_putit");

    divObj.append(rootDiv);

    if (json.data.length > 0) {
        divObj.append("<ul class=\"popMove_item\" ></ul>");
    }

    json.data.forEach(function (model) {
        if (!model.isempty) {
            var hasSubHtml = "<li class=\"popMove_putit\" onclick='openCopyDiv(\""+model.resid+"\",this)'>\n" +
                "<div class=\"popMove_name\" id='" + model.resid + "'><img src=\"/mooc2-ans/images/coursedata/file.png\"/><span class=\"popMove_text\">" + model.name + "</span></div></li>";
            divObj.find(".popMove_item").append(hasSubHtml);
        } else {
            var noSubHtml = "<li><div class=\"popMove_name\" id='" + model.resid + "'><img src=\"/mooc2-ans/images/coursedata/file.png\"/><span class=\"popMove_text\">" + model.name + "</span></div></li>";
            divObj.find(".popMove_item").append(noSubHtml);
        }
    });
}
function buildCloudDiskDiv(json, thisObj) {
    var thisDvi = $(thisObj);
    if (json.data.length > 0) {
        thisDvi.append("<ul class=\"popMove_item\" ></ul>");
    }
    json.data.forEach(function (model) {
        if(!model.isempty) {
            var hasSubHtml = "<li class=\"popMove_putit\" onclick='openCopyDiv(\""+model.resid+"\",this)'>\n" +
                "<div class=\"popMove_name\" id='"+model.resid+"'><img src=\"/mooc2-ans/images/coursedata/file.png\"/><span class=\"popMove_text\">"+model.name+"</span></div></li>";
            thisDvi.find(".popMove_item").append(hasSubHtml);
        } else {
            var noSubHtml = "<li><div class=\"popMove_name\" id='"+model.resid+"'><img src=\"/mooc2-ans/images/coursedata/file.png\"/><span class=\"popMove_text\">"+model.name+"</span></div></li>";
            thisDvi.find(".popMove_item").append(noSubHtml);
        }
    });
}

function submitCopyToCloudDisk() {
    var id =$(".popSaveShowHide .popMove_active").attr("id");
    if(!id || $.trim(id) === "") {
        $.toast({type: 'failure', content: I18N_Config.courseDataToast43});
        return;
    }

    var name = $(".popSaveShowHide").attr("name");
    var objectid = $(".popSaveShowHide").attr("objectid");
    var dataId = $(".popSaveShowHide").attr("dataId");
    var dataType = $(".popSaveShowHide").attr("dataType");
    var courseId = $("#courseid").val();
    var classid = $("#classId").val();
    var cpi = $("#cpi").val();

    $.ajax({
        type: "post",
        url : "/mooc2-ans/coursedata/copy-to-cloud-disk",
        data: {
            "name": name,
            "objectid": objectid,
            "dataId":dataId,
            "dataType":dataType,
            "fldid": id,
            "courseid":courseId,
            "cpi":cpi,
            "clazzid":classid,
            "ut":"s"
        },
        success: function (data) {
            if (data === "true") {
                $.toast({type: 'success', content: I18N_Config.addSuc});
                var currentPageNum = $("#pages").val();
                course_change(currentPageNum);
            } else {
                $.toast({type: 'failure', content: I18N_Config.courseDataToast44});
            }
            closeDeleteWindow();
        },
        error: function (data) {
            closeDeleteWindow();
            $.toast({type: 'failure', content: I18N_Config.courseDataToast44});
        }
    });
}

