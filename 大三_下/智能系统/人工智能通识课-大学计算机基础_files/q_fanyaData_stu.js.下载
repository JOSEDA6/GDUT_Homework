function downloadfile(filepath) {
    // 创建一个 form
    var form1 = document.createElement("form");
    form1.id = "form1";
    form1.name = "form1";
    // 添加到 body 中
    document.body.appendChild(form1);
    // form 的提交方式
    form1.method = "POST";
    // form 提交路径
    form1.action = filepath;
    form1.target = "_blank";
    // 对该 form 执行提交
    form1.submit();
    // 删除该 form
    document.body.removeChild(form1);
}

