//资料点击事件
function toOpen(dataName, dataType, dataId, loadurl, objectId, url, flag,
                source, classId, enc, videoType,t,bookEnc) {
    dataName = decodeURIComponent(dataName);
    var cpi = $("#cpi").val();
    var ut = $("#ut").val();
    if (typeof (cpi) == 'undefined' || cpi == null || cpi == '') {
        cpi = 0;
    }
    var courseId = $("#courseid").val();

    var isCdCustomCourseIds = $("#isCdCustomCourseIds").val();
    if (isCdCustomCourseIds && isCdCustomCourseIds == "true" && (dataType === "ppt" || dataType === "pptx" || dataType === "pdf")) {
        openWpsPreview(courseId, classId, dataId, "s");
        return;
    }
    
    if (flag === 1 && dataType !== "afolder") {
        if (objectId && objectId.length > 0 && (existType(dataType, previewType || dataType == "book"))) {
            // 可预览文件再次转码校验
            courseDataIsPreviewCheck(dataType, dataId, loadurl, objectId, flag, source,courseId);
        }
        viewOtherSource(dataId,dataType,courseId,classId,ut,cpi,url);
    } else {
        if (dataType === "afolder") {
           showDetail(courseId, dataName, dataId, 0, classId, enc,t);
        } else if (dataType === "jpg" || dataType === "png" || dataType === "gif" || dataType === "jpeg") {
            saveViewCount(dataId);
            pictureView(objectId);
        } else {
            if ((loadurl.length > 0 && objectId.length === 0 && dataId > 0 && dataType === 'doc')
                || (source === 1 && loadurl.length > 0)) {
                saveViewCount(dataId);
                param = "<input type=\"hidden\" name=\"realType\" value=\"html\"/><input type=\"hidden\" name=\"dataId\" value=\""
                    + dataId + "\"/>";
                putSubForm(param, ServerHost.mooc1Domain+"/coursedata/toPreview");
            } else if (dataType === "url" || dataType === "zt_chapter" || dataType === "swift_course"  || dataType === "topic") {
				saveViewCount(dataId);
                window.open(url);
            } else if (dataType === "periodical" || dataType === "note") {
                saveViewCount(dataId);
                var from = $("#from").val();
                window.open(url + "&_from_=" + from);
            }else if (dataType === "book") {
				saveViewCount(dataId);
                window.open("/mooc2-ans/book/read?ssid=" + objectId + "&courseId="
                    + courseId + "&classId=" + classId + "&enc=" + bookEnc);
            } else if (dataType === "video") {
                saveViewCount(dataId);
                if (videoType === 1) {
                    window.open(ServerHost.mooc1Domain+"/video/upload/play?courseId=" + courseId
                        + "&ztId=" + objectId + "&ztTitle=" + dataName
                        + "&videoId=" + dataId);
                } else {
                    window.open(ServerHost.mooc1Domain+"/video/play?courseId=" + courseId + "&ztId="
                        + objectId + "&ztTitle=" + dataName + "&videoId="
                        + dataId);
                }
            } else if (dataType === "svideo") {
                saveViewCount(dataId);
                if (videoType === 1) {
                    window.open(ServerHost.mooc1Domain+"/video/upload/play?courseId=" + courseId
                        + "&ztId=" + objectId + "&ztTitle=" + dataName
                        + "&videoId=" + dataId);
                } else {
                    window.open(ServerHost.mooc1Domain+"/video/newplay?courseId=" + courseId
                        + "&ztId=" + objectId + "&ztTitle=" + dataName
                        + "&videoId=" + dataId);
                }
            } else if (dataType === "ZT") {
				saveViewCount(dataId);
                var from = $("#from").val();
                window.open(ServerHost.mooc1Domain+"/course/" + objectId + ".html?_from_=" + from);
            } else if (objectId.length > 0 && existType(dataType, previewType)) {
                
				saveViewCount(dataId);
				intPreviewDiv(dataId, dataType);
            } else if(typeof dataType == "undefined" || dataType === "") {
                saveViewCount(dataId);
                var previewUrl = "/mooc2-ans/coursedata/preview-coursedata?dataId="+dataId+"&courseId="+courseId+"&classId="+classId+"&ut="+ut+"&cpi="+cpi;
                window.open(previewUrl);
            }
        }
    }
}

function intPreviewDiv(dataId, dataType) {
    var cpi = $("#cpi").val();
    var clazzid = $("#clazzid").val();
    var courseid = $("#courseid").val();

	$.ajax({
		type : "get",
		url : "/mooc2-ans/coursedata/get-preview-url",
		data : {
			"dataId": dataId,
            "cpi": cpi,
            "clazzid": clazzid,
            "ut": "s",
            "courseid":courseid
		},

		success : function(data) {
			var obj = JSON.parse(data);
			if(obj.status) {
				var popGroupScrollDiv = $(".popGroupShowHide #popGroup_scroll");
				popGroupScrollDiv.empty();
				var url= obj.url;
                if(url && window.location.protocol=="https:"){
                    url = url.replace("http://", window.location.protocol+"//");
                }
				url = encodeURI(url);
				if(dataType && (dataType.toLowerCase() === "mp3" || dataType.toLowerCase() === "m4a")) {
					$(".popGroupShowHide").find(".groupCon").attr("style","width:362px");
					var html = "<iframe scrolling=\"auto\" allowfullscreen=\"true\" allowtransparency=\"true\" id=\"layui-layer-iframe2\" name=\"layui-layer-iframe2\" onload=\"this.className='';\" " +
						"class=\"\" frameborder=\"0\" src=\""+url+"\" style=\"height: 424px; width: 362px;\"></iframe>";
					popGroupScrollDiv.append(html);
				}else {
					$(".popGroupShowHide").find(".groupCon").attr("style","");
					var html= "<iframe scrolling=\"auto\" allowfullscreen=\"true\" allowtransparency=\"true\" id=\"layui-layer-iframe2\" " +
						"name=\"layui-layer-iframe2\" onload=\"this.className='';\" class=\"\" frameborder=\"0\" " +
						"src=\""+url+"\" style=\"height: 580px; width: 1120px;\">";
					popGroupScrollDiv.append(html);
				}

				$('.popGroupShowHide').fullFadeIn();
				$('.popGroupShowHide').addClass('maskFadeOut');
				$('body').addClass('popOverflow')
			}else {
				$.toast({type: 'failure', content: I18N_Config.courseDataToast16});
			}
		},
		error : function(data) {
			$.toast({type: 'failure', content: I18N_Config.courseDataToast16});
		}
	});
}

