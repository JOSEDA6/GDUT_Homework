    var hasFolder = false;
    $(".dataBody_check").each(function () {
        //是否选中，是否有文件夹，是否包含不支持下载的文件
        if($(this).hasClass('dataBody_checked') && ($(this).parent().find("#folderTypeId").length > 0 || !checkDownload(this))){
