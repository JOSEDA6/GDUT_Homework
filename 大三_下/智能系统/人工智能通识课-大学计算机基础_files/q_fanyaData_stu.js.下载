function existType(type, arrayName) {
	for (var i = 0; i < arrayName.length; i++) {
		if (arrayName[i] === type) {
			return true;
		}
	}
	return false;
}

function viewOtherSource(dataId,dataType,courseId,classId,ut,cpi,url) {
    if(dataType === "note" || dataType === "topic" || dataType === "notice" || dataType === "live") {
        saveViewCount(dataId);
        if(ut !== "t" && dataType === "note") {
            var previewUrl = "/mooc2-ans/coursedata/preview-coursedata?dataId="+dataId+"&courseId="+courseId+"&classId="+classId+"&ut="+ut+"&cpi="+cpi+"&from="+$("#from").val();
            window.open(previewUrl);
        }else {
            window.open(url);
        }
    }else if(typeof dataType == "undefined" || dataType === "") {
        saveViewCount(dataId);
        var previewUrl = "/mooc2-ans/coursedata/preview-coursedata?dataId="+dataId+"&courseId="+courseId+"&classId="+classId+"&ut="+ut+"&cpi="+cpi;
        window.open(previewUrl);
    }else if(dataType && dataType.toLowerCase() === "m4a") {
        saveViewCount(dataId);
        intPreviewDiv(dataId, dataType);
    }
}

