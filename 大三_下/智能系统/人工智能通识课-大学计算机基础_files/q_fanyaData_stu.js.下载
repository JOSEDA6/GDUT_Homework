        $(_this).removeClass("sort_down");
        $(_this).addClass("sort_up");
    } else {
        $(_this).removeClass("sort_up");
        $(_this).addClass("sort_down");
    }
	var courseid = $("#courseid").val();
	var clazzid = $("#clazzid").val();
	var cpi = $("#cpi").val();
	var enc = $("#enc").val();
	var ut =$("#ut").val();
	var dataName = $("#dataName").val();
