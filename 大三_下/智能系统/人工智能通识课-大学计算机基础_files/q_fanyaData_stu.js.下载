function course_change(pageno) {
	var courseId = $("#courseid").val();
	var classId = $("#classId").val();
	var search = $("#search").val();
	var dataName = $("#dataName").val();
	var orders = $("#orders").val();
	var cpi = $("#cpi").val();
	var enc = $("#enc").val();
	var t = $("#t").val();
	var dataId = $("#dataId").val();
	var microTopicId = $("#microTopicId").val();
    var url = "";
    try {
        dataName = encodeURIComponent(dataName);
    }catch (e) {
    }
	if(search) {
        url = "/mooc2-ans/coursedata/search-stu?courseId=" + courseId + "&classId=" + classId + "&pages=" + pageno + "&dataName="+dataName+"&order="+orders+"&enc="+enc+"&cpi="+cpi+"&t="+t + "&microTopicId=" + microTopicId;
	} else{
        url = "/mooc2-ans/coursedata/stu-datalist?courseid=" + courseId + "&clazzid=" + classId + "&pages=" + pageno + "&type=1&dataName="+dataName+"&dataId="+dataId+"&order="+orders+"&enc="+enc+"&cpi="+cpi+"&t="+t + "&microTopicId=" + microTopicId;
	}
	reloadPage(url);
}


