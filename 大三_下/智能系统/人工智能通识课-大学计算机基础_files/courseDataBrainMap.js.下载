function showDocumentInfo(type,data) {
    var contentDiv = $("#document_content_" + type);
    if(0 === type) {
        $("#document_content_0").text(data);
    } else {
        if (data.indexOf("index.html#") > -1) {
            var dateStamp = new Date().getTime();
            data = data.replace("index.html#", "index.html?v=" + dateStamp + "#");
        }
        contentDiv.attr("src", data);
    }

    $("#loading_" + type).hide();
    contentDiv.show();
    showDocumentAi();
}

function showErrorDocumentInfo(type) {
    var contentDiv = $("#document_content_" + type);
    if(0 === type) {
        $("#document_content_0").text("");
    } else {
        contentDiv.attr("src", "");
        $(".ai-anaysis-full").hide();
    }

    $("#loading_" + type).hide();
    $("#analyLose_" + type).show();
}

var brainCache = [];
var documentInfo = {};
var docType = {};
function openAiBrainMap(type) {
    var objectId = $("#documentObjectId").val();
    var showAiBrainMap = $("#showAiBrainMap").val();
    var useBigModelAnalysis = $("#useBigModelAnalysis").val();
    var aiVideoInterpret = $("#aiVideoInterpret").val();
    if(typeof showAiBrainMap !== "undefined" && showAiBrainMap == "true" && typeof useBigModelAnalysis != "undefined" && useBigModelAnalysis == "true" && typeof aiVideoInterpret != "" && aiVideoInterpret == "1" && typeof documentInfo[objectId] != "undefined") {
        var objInfo = documentInfo[objectId];
        if (type == 0) {
            var url = objInfo["summary"].data;
            showDocumentInfo(type, url);
        } else if (type == 1) {
            var url = objInfo["mindmap"].data;
            showDocumentInfo(type, url);
        } else if (type == 2) {
            var url = objInfo["wordcloud"].data;
            showDocumentInfo(type, url);
        }
        return;
    }
    var documentDataId = $("#documentDataId").val();
    try {
        for (var i=0;i< brainCache.length; i++) {
            var info = brainCache[i];
            if (info.objectId == objectId && info.type == type) {
                var url = info.url;
                showDocumentInfo(type, url);
                return;
            }
        }

        var ut = $("#ut").val();
        var classId = $("#classId").val();
        var courseId = $("#courseid").val();
        $.ajax({
            type : "get",
            url : "/mooc2-ans/query-brain-map",
            dataType: "json",
            data : {
                courseId : courseId,
                dataId : documentDataId,
                type: type,
                ut:ut,
                clazzId:classId
            },

            success : function(data) {
                if(data.status) {
                    var url = data.data;
                    var info = {
                        objectId:objectId,
                        url: url,
                        type: type
                    }

                    brainCache.push(info);
                    showDocumentInfo(type, url);
                } else {
                    showErrorDocumentInfo(type);
                    $.toast({type: 'failure', content: data.msg});
                }
            },
            error : function(data) {
                showErrorDocumentInfo(type);
            }
        });
    }catch (ex) {
        console.log(ex);
    }
}

var supportType = ["pdf","doc","docx"];

function checkAiBrainMapNew() {
    try {
        var dataIdArray = [];
        $(".dataBody_td").each(function () {
            var type = $(this).attr("type");
            var dataId = $(this).attr("id");
            var objectId = $(this).attr("objectId");

            if(supportType.includes(type.toLowerCase())) {
                dataIdArray.push(dataId);
                docType[objectId] = "." + type;
            }
        })

        if(dataIdArray.length == 0) {
            return
        }

        var ut = $("#ut").val();
        var classId = $("#classId").val();
        var courseId = $("#courseid").val();
        $.ajax({
            type : "post",
            url : "/mooc2-ans/query-brain-map-model",
            dataType: "json",
            data : {
                "courseId" : courseId,
                "dataIds": dataIdArray.join(","),
                "ut":ut,
                "clazzId":classId
            },

            success : function(data) {
                if(data.status) {
                    var list = data.data;
                    for (var i = 0; i < list.length; i++) {
                        var objId = list[i].objectId;
                        var objData = list[i].data;
                        if (!objData) {
                            continue;
                        }
                        var summary = objData.summary;
                        var mindMap = objData.mindmap;
                        var wordcloud = objData.wordcloud;
                        if ((docType[objId] != ".pdf" && !(summary["mark"] == 2 && mindMap["mark"] == 2 && wordcloud["mark"] == 2)) || (docType[objId] == ".pdf"&& summary["mark"] != 2 && mindMap["mark"] != 2)) {
                            continue;
                        }
                        documentInfo[objId] = objData;
                        $(".dataBody_td").each(function ()  {
                            var type = $(this).attr("type");
                            if(supportType.includes(type.toLowerCase())) {
                                var objectId = $(this).attr("objectid");
                                if(typeof documentInfo[objectId] != "undefined") {
                                    $(this).find(".ai-anaysis-btn").show();
                                }
                            }
                        });
                    }
                }
            },
            error : function(data) {
            }
        });
    }catch (ex) {
        console.log(ex);
    }
};
