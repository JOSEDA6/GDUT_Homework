var page = {
	showPage : function(currentPage, countPage, changeMethod, first, last) {
		var str = "";
		var countNum;
		if (typeof (first) === 'undefined') {
			first = "首页";
		}
		if (typeof (last) === 'undefined') {
			last = "尾页";
		}
		// head
		if (currentPage === 1) {
			str += '<a class="prve_page_disable"><i></i></a>';
		} else {
			str += '<a  href="javascript:void(0)" class="prvePage" onclick=\"'
					+ changeMethod + '(' + (currentPage - 1) + ')\"'
					+ '"><i></i></a>';
		}

		// pageNum
		if (currentPage < 4 || countPage < 6) {
			countNum = 1;
		} else if (currentPage + 2 > countPage) {
			countNum = countPage - 4;
		} else {
			countNum = currentPage - 2;
		}

		var countPage1 = parseInt(countPage) + 1;
		var countNum1 = parseInt(countNum);
		// body
		for (var i = countNum1; i < countPage1; i++) {

			if (i === currentPage) {
				str += '<a class="curPage">' + i + '</a>';
			} else {
				str += '<a  href="javascript:void(0)" onclick=\"'
						+ changeMethod + '(' + i + ')\"' + '">' + i + '</a>';
			}

			if (i === countNum + 4) {
				break;
			}

		}
		// end
		if (currentPage === countPage) {
			str += '<a href="javascript:void(0)"  class=\"next_page_disable\"><i></i></a>';
		} else {
			str += '<a  href="javascript:void(0)" class="nextPage" onclick=\"'
					+ changeMethod + '(' + (currentPage + 1) + ')\"'
					+ '"><i></i></a>';
		}
		if (countPage1 > 2) {
			$(".pageDiv").empty().append(str);
		}
	}
};