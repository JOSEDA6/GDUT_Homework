	//创建多个下载框用于批量下载
	function createIFrame(url) {
		location.href = url;
	}

	// 批次大小
	var batchSize = 1;
	// 批次之间的延迟时间（毫秒）
	var delay = 2000;

	// 用于分批处理的函数
	function processBatch(obj, currentIndex = 0) {
		var end = Math.min(currentIndex + batchSize, obj.length); // 计算本次处理的结束位置
		for (var i = currentIndex; i < end; i++) {
			createIFrame(obj[i]);
		}

		// 如果还有剩余元素未处理，则设置延时继续处理下一批
		if (end < obj.length) {
			setTimeout(() => processBatch(obj, end), delay);
		}
	}

	//批量下载pop
	$('#courseDataContent').on('click','.popDownBnt',function(){
		var dataId = [];
		$(".dataBody_check").each(function () {
			if($(this).hasClass('dataBody_checked')){
				dataId.push($(this).find(":checkbox").prop("value"));
			}
		});

		var courseId = $('#courseid').val();
		var classId = $('#classId').val();
		var ut = $('#ut').val();
		if (dataId.length > 0) {
			$.ajax({
				type : "get",
				url : "/mooc2-ans/coursedata/batchDownload",
				data : {
					"dataId" : dataId.join(),
					"courseId" : courseId,
					"classId" : classId,
					"ut" : ut
				},
				success : function(data) {
					var obj = JSON.parse(data);
					// 开始处理第一批
					processBatch(obj);
				},
				error : function(data) {
					$.toast({type: 'failure', content: I18N_Config.courseDataToast47});
				}
			});
		} else {
			$.toast({type: 'failure', content: I18N_Config.courseDataToast48});
		}
	});

